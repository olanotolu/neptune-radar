# Neptune Radar — deploy image: prebuilt artifacts only.
# The EC2 t3.micro cannot build Go/npm in-image without wedging (1 GB RAM), so
# `make deploy` cross-compiles the Go binaries and builds the frontend locally,
# then this Dockerfile just copies the results. Remote `docker build` is
# seconds of COPY instead of minutes of compiling on 1 vCPU.
FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata curl
WORKDIR /app
COPY build/server /app/server
COPY build/seed-geography /app/seed-geography
COPY build/bootstrap-state /app/bootstrap-state
COPY frontend/dist /app/public
# DASHBOARD_ORIGIN is deliberately NOT baked in — the deploy env file
# (~/neptune-radar.env on the box) owns it. A baked-in fly.dev default here
# once made every CORS answer point at a deployment that didn't exist.
ENV ADDR=":8080" \
    STATIC_DIR="/app/public"
EXPOSE 8080
# A deadlocked watch loop with a live HTTP socket used to pass as "up".
# /api/health pings Postgres, so this catches DB-dead too.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -sf http://localhost:8080/api/health || exit 1
CMD ["/app/server"]
