# Neptune Radar — environment. Copy to backend/.env for local dev.

# --- required ---
# Two real database setups exist — do not mix them up:
#   PRODUCTION (EC2): dockerized Postgres container `neptune-pg` on the same
#     box; the URL lives in ~/neptune-radar.env on the instance (never here).
#   LOCAL DEV: Supabase project — prefer the session pooler (IPv4) URL from
#     Project Settings → Database → Connection string → Session mode:
#       postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#     Direct db.<ref>.supabase.co is often IPv6-only and fails from some ISPs.
# Both databases auto-migrate on server boot — keep them on the same binary.
DATABASE_URL=postgres://postgres:test@localhost:55432/neptune_test?sslmode=disable
NEPTUNE_ADMIN_TOKEN=dev-token-change-me
# Tracked soft-invite deep link base (Growth OS handoff → Meet Neptune chat)
NEPTUNE_CHAT_BASE_URL=https://app.meetneptune.com/chat
# Product webhooks (chat_started / consult_booked / closed_*) — Bearer or X-Neptune-Webhook-Secret
# Prefer a dedicated secret so app integrations never share the dashboard admin token.
NEPTUNE_WEBHOOK_SECRET=

# --- data provider (watch loop idles without one) ---
# Bright Data is preferred when set (Instagram Profiles + Posts scrapers).
# Get key: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=
# Optional fallback if Bright Data is unset:
APIFY_TOKEN=

# --- models (template fallback covers everything without these) ---
# Primary LLM for detective home-market, copy, analyst (prefer OpenAI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions  # optional gateway
BASETEN_API_KEY=
BASETEN_MODEL=
BASETEN_VISION_MODEL=
ANTHROPIC_API_KEY=          # optional secondary/fallback
NEPTUNE_LLM_MODEL=          # overrides the Claude model id

# --- ops knobs ---
# Ohio is the product market; each entry also drives location-hashtag
# classification (signals.Markets), so the two must stay in sync.
# Ohio product markets + Phase 1 NY/CA expansion tokens (bootstrap-state).
ACTIVE_MARKETS=columbus,cbus,cleveland,cincinnati,dayton,akron,toledo,nyc,manhattan,newyork,centralpark,brooklyn,dumbo,losangeles,la,hollywood,santamonica,beverlyhills,malibu,sanfrancisco,sf,bayarea,napa,sonoma
DAILY_BUDGET_CAP=500
DASHBOARD_ORIGIN=http://localhost:5173
# STATIC_DIR=/app/public     # set in the deployed image only
# VITE_API_URL=http://localhost:8080  # frontend dev override

# --- detective: people-search (name + city → address candidates) ---
# Cascade merges (does not first-wins): paid → free public records → heuristic.
# Paid: Trestle → PDL → Melissa → Cleanlist (all configured keys run, high-conf early stop).
# Free: Google CSE → TruePeopleSearch (Bright Data) → county property → voter → OH zip heuristic.
# Research URLs are never treated as street addresses.
# Trestle IQ: $0.07/query, continuously maintained address graph.
TRESTLE_API_KEY=
# PDL: $0.05/query, large raw dataset + Instagram profile match.
PDL_API_KEY=
# Melissa People Search (optional paid).
MELISSA_LICENSE_KEY=
# Cleanlist: free search, $0.01-0.11 enrichment.
CLEANLIST_API_KEY=
# Google Custom Search (100 free queries/day) — snippet address parse.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# Apify — master pause. TOKEN can sit idle with zero spend.
APIFY_TOKEN=
# MASTER KILL SWITCH (default false): blocks TPS hunters AND Instagram Apify actors.
APIFY_ENABLED=false
# TPS hunters also need this true (second gate) for people-search only.
APIFY_TPS_ENABLED=false
APIFY_TPS_MAX_ITEMS=2
APIFY_TPS_MAX_CALLS_PER_DETECTIVE=1
APIFY_TPS_ALLOW_FALLBACK=false
# APIFY_TPS_ACTOR=jungle_synthesizer~truepeoplesearch-people-search-scraper

# Bright Data Web Unlocker — optional second TPS path (needs a Web Unlocker *zone*).
# BRIGHTDATA_API_KEY alone is NOT enough: you must create a Web Unlocker *zone*
# in the Bright Data dashboard (Zones → Add zone → Web Unlocker), then set:
BRIGHTDATA_UNLOCKER_ZONE=
# Without a valid zone, Run detective only returns TPS research links (not streets).
# BRIGHTDATA_API_KEY is also used by Instagram dataset scrapers when set.
# Max paid people-data API calls per detective run (name×location fan-out).
# Default 8; free text extract and free scrapers do not count.
DETECTIVE_PAID_CAP=8

# --- mail: Lob Print & Mail (USPS verify + send 4x6 postcard) ---
# test_… keys never charge postage; live_… keys send real mail.
LOB_API_KEY=
LOB_FROM_NAME=Neptune
LOB_FROM_LINE1=
LOB_FROM_CITY=
LOB_FROM_STATE=
LOB_FROM_ZIP=
LOB_FROM_COUNTRY=US
