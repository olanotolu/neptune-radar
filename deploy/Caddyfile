# Neptune Radar — Caddy config (tracked copy).
# Live copy on the EC2 box is bind-mounted from ~/Caddyfile; `make deploy`
# rsyncs this file over it. The domain encodes the instance's public IP —
# if the box ever gets an Elastic IP / real DNS name, update BOTH here.
# Detective (Apify TPS) can take several minutes — default proxy timeouts return 502
# and kill the operator's "Run detective" button mid-hunt.
54.196.158.87.sslip.io {
	reverse_proxy neptune-radar:8080 {
		transport http {
			dial_timeout 10s
			response_header_timeout 15m
			read_timeout 15m
			write_timeout 15m
		}
	}
}
